# Mobile app build-time environment (public — safe to commit).
# These are baked into the APK at build time via EAS.

# Base URL of the deployed backend (no trailing slash).
# For local Expo Go dev this can be left empty (auto-detected from host IP).
EXPO_PUBLIC_API_URL=https://delta-paper-trader.fly.dev

# Shared static token checked by the backend on the WebSocket handshake.
# Must match the WS_AUTH_TOKEN Fly secret. Keep it secret but it is
# embedded in the APK (acceptable for personal 2-device use).
EXPO_PUBLIC_WS_TOKEN=change-me-to-a-long-random-string
