# Angel One SmartAPI Credentials
# Replace these values with your actual SmartAPI credentials
ANGEL_API_KEY="your_api_key_here"
ANGEL_CLIENT_ID="your_client_id_here"
ANGEL_PASSWORD="your_password_here"

# Base32 Secret Key for TOTP Generation (from Google Authenticator Setup)
ANGEL_TOTP_SECRET="ABCDEFGHIJKLMNOPQRSTUVWXYZ123456"

# API CORS Security configuration
# Comma-separated list of origins allowed to call the API in production
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

